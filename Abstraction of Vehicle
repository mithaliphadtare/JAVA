package abc;
abstract class Vehicle{
	abstract void start();
	abstract void stop();
	void display() {
		System.out.println("vehicle is operating");
	}
}
class Bus extends Vehicle{
	void start() {
		System.out.println("Bus started!");
	}
	void stop() {
		System.out.println("Bus stoped!");
	}
	void display() {
		System.out.println("Bus is operating");
	}
}
class Car extends Vehicle{
	void start() {
		System.out.println("car started!");
	}
	void stop() {
		System.out.println("car stoped!");
	}
	void display() {
		System.out.println("car is operating");
	}
}
public class Assignment10 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		Vehicle bus=new Bus();
		bus.start();
		bus.stop();
		bus.display();
		Vehicle car=new Car();
		car.start();
		car.stop();
		car.display();
		
	}

}
